{
    "productName":  "FF7 Ultima",
    "version":  "1.9.0",
    "identifier":  "org.m4v3r.ff7-ultima",
    "build":  {
                  "beforeDevCommand":  "bun --bun run dev-server",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "bun --bun run build-server",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "Ultima - FF7 Real-time Game Editor",
                                    "width":  720,
                                    "height":  635,
                                    "theme":  "Dark",
                                    "backgroundColor":  "#111212",
                                    "visible":  true,
                                    "resizable":  true,
                                    "maximizable":  true
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "nsis",
                   "createUpdaterArtifacts":  true,
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ]
               },
    "plugins":  {
                    "updater":  {
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaW5nIHB1YmxpYyBrZXk6IDI2MzY5Q0ExRjlGQTc3MDUKUldRRmQvcjVvWncySmtyMndFK01ORGFjSkNjUzVjVmljVExnaUczN2VVWnRFc09QQUx5c01YM3cK",
                                    "endpoints":  [
                                                      "https://github.com/themattdavis/ff7-ultima/releases/latest/download/latest.json"
                                                  ],
